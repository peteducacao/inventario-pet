{
  "name": "inventario-pet",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventario-pet",
      "database_id": "af1f45ca-16eb-457c-98b1-7841ef777570",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *",
      "0 12 * * *"
    ]
  }
}